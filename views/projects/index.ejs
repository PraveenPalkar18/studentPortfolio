<%- include('../partials/header', { user }) %>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small">All projects</div>
      <div class="h3 mb-0"><%= summary.total %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small">In progress</div>
      <div class="h3 mb-0"><%= summary.pending %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small">Completed</div>
      <div class="h3 mb-0"><%= summary.completed %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small">Overdue</div>
      <div class="h3 mb-0 text-danger"><%= summary.overdue %></div>
    </div></div>
  </div>
</div>

<div class="row">
  <div class="col-lg-8 mb-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h5 class="mb-0">Projects</h5>
          <span class="small text-muted"><%= summary.dueSoon %> due within 7 days</span>
        </div>
      </div>
      <div class="card-body border-bottom">
        <form method="GET" action="/projects" class="row g-2">
          <div class="col-md">
            <label for="project-search" class="visually-hidden">Search projects</label>
            <input id="project-search" type="search" name="q" class="form-control"
                   value="<%= filters.search %>" placeholder="Search title or description">
          </div>
          <div class="col-sm-5 col-md-4">
            <label for="project-status" class="visually-hidden">Filter by status</label>
            <select id="project-status" name="status" class="form-select">
              <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All statuses</option>
              <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>In progress</option>
              <option value="COMPLETED" <%= filters.status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
            </select>
          </div>
          <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
          <% if (hasFilters) { %>
            <div class="col-auto"><a href="/projects" class="btn btn-outline-secondary">Clear</a></div>
          <% } %>
        </form>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Due</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (projects.length === 0) { %>
              <tr><td colspan="5" class="text-center text-muted py-4">
                <%= hasFilters ? 'No projects match these filters.' : 'No projects yet. Add your first project to get started.' %>
              </td></tr>
            <% } %>
            <% projects.forEach(p => { %>
              <tr>
                <td>
                  <strong><%= p.title %></strong>
                  <div class="small text-muted">
                    <%= p.description ? (p.description.length > 60 ? p.description.substring(0, 60) + '...' : p.description) : '' %>
                  </div>
                </td>
                <td>
                  <span class="badge <%= p.status === 'COMPLETED' ? 'text-bg-success' : 'text-bg-warning' %>">
                    <%= p.status === 'COMPLETED' ? 'Completed' : 'In progress' %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= getPriorityClass(p.priority) %>">
                    <%= getPriorityLabel(p.priority) %>
                  </span>
                </td>
                <td>
                  <% const dueStatus = getDueDateStatus(p.dueDate, p.status); %>
                  <% if (p.dueDate) { %>
                    <span class="<%= dueStatus === 'overdue' ? 'text-danger fw-semibold' : '' %>">
                      <%= new Date(p.dueDate).toLocaleDateString() %>
                    </span>
                    <% if (dueStatus === 'overdue') { %><span class="badge text-bg-danger ms-1">Overdue</span><% } %>
                    <% if (dueStatus === 'due-soon') { %><span class="badge text-bg-info ms-1">Due soon</span><% } %>
                  <% } else { %>-<% } %>
                </td>
                <td class="text-end">
                  <a href="/projects/<%= p._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                  <form action="/projects/<%= p._id %>?_method=DELETE" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this project?')">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4 mb-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0">
        <h5 class="mb-0">Add Project</h5>
      </div>
      <div class="card-body">
        <form method="POST" action="/projects">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" maxlength="120" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" maxlength="1000"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              <option value="PENDING">In progress</option>
              <option value="COMPLETED">Completed</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Priority</label>
            <select name="priority" class="form-select">
              <% projectPriorities.forEach(priority => { %>
                <option value="<%= priority %>" <%= priority === 'MEDIUM' ? 'selected' : '' %>>
                  <%= getPriorityLabel(priority) %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Due Date</label>
            <input type="date" name="dueDate" class="form-control">
          </div>
          <button class="btn btn-primary w-100">Save</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
